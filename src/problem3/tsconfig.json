{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  // vitest.setup.ts must be included: it imports
  // `@testing-library/jest-dom/vitest`, and that import is what augments
  // Vitest's Assertion type with toBeInTheDocument and friends. Leaving it out
  // typechecks the tests without the matchers they actually use.
  "include": ["src", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["src/messy.original.tsx"]
}
